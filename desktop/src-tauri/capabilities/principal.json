{
  "$schema": "https://raw.githubusercontent.com/nicdelhi/tauri2-schema/main/capability.json",
  "identifier": "principal",
  "description": "Permisos principales de la app Kamples Desktop",
  "windows": ["main", "sync-panel", "config-sync"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-close",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-watch",
    "fs:allow-stat",
    "fs:scope-home-recursive",
    "fs:scope-download-recursive",
    "fs:scope-appdata-recursive",
    "os:default",
    "os:allow-locale",
    "os:allow-platform",
    "os:allow-version",
    "os:allow-os-type",
    "os:allow-arch",
    "process:default",
    "process:allow-exit",
    "process:allow-restart",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "^https://(www\\.)?kamples\\.com(/|$)" }
      ]
    },
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-keys",
    "store:allow-values",
    "store:allow-entries",
    "store:allow-length",
    "store:allow-load",
    "store:allow-save",
    "store:allow-clear",
    "updater:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "window-state:default",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    "drag:default",
    "drag:allow-start-drag"
  ]
}
