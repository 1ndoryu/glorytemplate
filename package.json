{
    "name": "glory-theme",
    "version": "1.0.0",
    "scripts": {
        "dev": "npm run dev --prefix Glory/assets/react",
        "build": "npm run build --prefix Glory/assets/react",
        "build:fast": "npm run build:fast --prefix Glory/assets/react",
        "prerender": "npm run prerender --prefix Glory/assets/react",
        "install:all": "npm install && npm install --prefix Glory/assets/react && npm install --prefix App/React",
        "types:add": "npm install --prefix App/React"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "zustand": "^5.0.10"
    }
}
