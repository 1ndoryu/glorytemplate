{
    "name": "glory-theme",
    "version": "1.0.0",
    "bin": {
        "glory": "./Glory/cli/glory.mjs"
    },
    "scripts": {
        "dev": "npm run dev --prefix Glory/assets/react",
        "build": "npm run build --prefix Glory/assets/react",
        "build:fast": "npm run build:fast --prefix Glory/assets/react",
        "prerender": "npm run prerender --prefix Glory/assets/react",
        "lint": "npm run lint --prefix Glory/assets/react",
        "lint:fix": "npm run lint:fix --prefix Glory/assets/react",
        "format": "npm run format --prefix Glory/assets/react",
        "format:check": "npm run format:check --prefix Glory/assets/react",
        "type-check": "npm run type-check --prefix Glory/assets/react",
        "create": "node Glory/cli/glory.mjs create",
        "docs:dev": "npm run docs:dev --prefix Glory/docs",
        "docs:build": "npm run docs:build --prefix Glory/docs",
        "docs:preview": "npm run docs:preview --prefix Glory/docs",
        "tauri:dev": "npm run tauri:dev --prefix desktop",
        "desktop:dev": "npm run tauri:dev --prefix desktop",
        "install:all": "npm install && npm install --prefix Glory/assets/react && npm install --prefix App/React && npm install --prefix desktop",
        "install:subdeps": "npm install --prefix Glory/assets/react --ignore-scripts && npm install --prefix App/React --ignore-scripts && npm install --prefix desktop --ignore-scripts",
        "postinstall": "npm run install:subdeps",
        "types:add": "npm install --prefix App/React"
    },
    "dependencies": {
        "@measured/puck": "^0.20.2"
    },
    "devDependencies": {
        "sharp": "^0.34.5"
    }
}
