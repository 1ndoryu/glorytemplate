{
    "name": "glory-theme",
    "private": true,
    "version": "1.0.0",
    "description": "Glory WordPress Theme - Comandos centralizados",
    "scripts": {
        "dev": "node scripts/run-clean.mjs -- npm run dev --prefix Glory/assets/react",
        "build": "node scripts/run-clean.mjs -- npm run install:glory && node scripts/run-clean.mjs -- npm run build --prefix Glory/assets/react",
        "build:fast": "node scripts/run-clean.mjs -- npm run install:glory && node scripts/run-clean.mjs -- npm run build:fast --prefix Glory/assets/react",
        "prerender": "node scripts/run-clean.mjs -- npm run install:glory && node scripts/run-clean.mjs -- npm run prerender --prefix Glory/assets/react",
        "postinstall": "node scripts/run-clean.mjs -- npm install --prefix App/React",
        "install:glory": "node scripts/run-clean.mjs -- npm install --prefix Glory/assets/react --no-audit --no-fund",
        "install:all": "node scripts/run-clean.mjs -- npm run install:glory && node scripts/run-clean.mjs -- npm install --prefix App/React",
        "types:add": "npm install --save-dev --prefix App/React",
        "type-check": "npm run type-check --prefix Glory/assets/react && npm run type-check --prefix App/React",
        "type-check:glory": "npm run type-check --prefix Glory/assets/react",
        "type-check:app": "npm run type-check --prefix App/React",
        "roadmap": "node scripts/check-roadmap.mjs",
        "roadmap:watch": "node scripts/check-roadmap.mjs --watch",
        "opencode:runner": "node scripts/opencode-whatsapp-runner.mjs",
        "opencode:runner:loop": "node scripts/opencode-whatsapp-runner.mjs loop --api-url https://task.nakomi.studio/wp-json/glory/v1",
        "self-check": "powershell -ExecutionPolicy Bypass -File scripts/self-check.ps1",
        "task:check": "node scripts/quality/runner.mjs",
        "task:status": "sentinel task status --project-root . --json",
        "task:release": "sentinel task release",
        "quality:setup": "node scripts/quality/setup.mjs",
        "quality:test": "node scripts/quality/test.mjs",
        "quality:lock": "node scripts/quality/lock.mjs",
        "quality:doctor": "node scripts/quality/doctor.mjs",
        "quality:guard": "node scripts/quality/guard.mjs",
        "quality:preflight": "node scripts/quality/preflight.mjs",
        "quality:reports:cleanup": "node scripts/quality/cleanup.mjs reports",
        "quality:reports:cleanup:dry": "node scripts/quality/cleanup.mjs reports --dry",
        "quality:cleanup": "node scripts/quality/cleanup.mjs",
        "quality:cleanup:dry": "node scripts/quality/cleanup.mjs --dry",
        "quality:scope": "node scripts/quality/scope.mjs"
    },
    "dependencies": {
        "@measured/puck": "^0.20.2"
    }
}
