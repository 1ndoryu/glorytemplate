{
    "name": "glory-theme",
    "private": true,
    "version": "1.0.0",
    "description": "Glory WordPress Theme - Comandos centralizados",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:wp": "npm run wp:start && npm run wp:activate",
        "dev:vite": "npm run dev --prefix Glory/assets/react",
        "wp:start": "node scripts/wp-start.mjs",
        "wp:stop": "npm exec -- wp-env stop",
        "wp:status": "npm exec -- wp-env run cli wp core version",
        "wp:activate": "npm exec -- wp-env run cli wp theme activate glorytemplate",
        "wp:export": "node scripts/wp-export.mjs",
        "wp:import": "node scripts/wp-import.mjs",
        "wp:replace-url": "node scripts/wp-replace-url.mjs",
        "wp:destroy": "npm exec -- wp-env destroy",
        "infra:check": "node scripts/check-dev-infra.mjs",
        "build": "npm run install:glory && npm run build --prefix Glory/assets/react",
        "build:fast": "npm run install:glory && npm run build:fast --prefix Glory/assets/react",
        "prerender": "npm run install:glory && npm run prerender --prefix Glory/assets/react",
        "postinstall": "npm install --prefix App/React",
        "install:glory": "npm install --prefix Glory/assets/react --no-audit --no-fund",
        "install:all": "npm run install:glory && npm install --prefix App/React",
        "types:add": "npm install --save-dev --prefix App/React",
        "type-check": "npm run type-check --prefix Glory/assets/react && npm run type-check --prefix App/React",
        "type-check:glory": "npm run type-check --prefix Glory/assets/react",
        "type-check:app": "npm run type-check --prefix App/React",
        "roadmap": "node scripts/check-roadmap.mjs",
        "roadmap:watch": "node scripts/check-roadmap.mjs --watch",
        "opencode:runner": "node scripts/opencode-whatsapp-runner.mjs",
        "opencode:runner:loop": "node scripts/opencode-whatsapp-runner.mjs loop --api-url https://task.nakomi.studio/wp-json/glory/v1",
        "self-check": "powershell -ExecutionPolicy Bypass -File scripts/self-check.ps1"
    },
    "dependencies": {
        "@measured/puck": "^0.20.2"
    },
    "devDependencies": {
        "@wordpress/env": "11.12.0"
    }
}
