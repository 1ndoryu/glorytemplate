# Cache headers para assets estaticos del tema.
# SVGs de landing, fuentes, CSS/JS compilados, imagenes.
#
# Los SVGs son pesados (4.5MB hero) pero inmutables (se versionan con ?v=).
# Cache agresivo 1 año + immutable para evitar revalidaciones innecesarias.

<IfModule mod_expires.c>
    ExpiresActive On

    # SVGs e imagenes: 1 año (inmutables, versionadas con query string)
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fuentes: 1 año
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # CSS/JS compilados: 1 año (Vite genera hashes en nombres de archivo)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Audio: 3 meses
    ExpiresByType audio/mpeg "access plus 3 months"
    ExpiresByType audio/ogg "access plus 3 months"
    ExpiresByType audio/wav "access plus 3 months"

    # HTML/PHP: sin cache (contenido dinamico)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Assets estaticos: cache inmutable 1 año
    <FilesMatch "\.(svg|js|css|woff|woff2|ttf|jpg|jpeg|png|gif|webp|ico|mp3|ogg|wav)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Vary "Accept-Encoding"
    </FilesMatch>

    # CORS: permite fetch/img cross-origin desde Tauri (desktop/Android).
    # Archivos publicos del tema — patron CDN Access-Control-Allow-Origin: *
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|json|mp3|ogg|wav)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
    </FilesMatch>

    # PHP: sin cache
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Compresion GZIP para assets comprimibles (SVG se comprime especialmente bien)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff font/ttf
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>
