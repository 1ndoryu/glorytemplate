# Variables de Entorno - GloryTemplate / Kamples
# Copia este archivo como .env y configura los valores
# Las variables con ${...} se expanden desde el entorno del host via coolify-manager

# General
DEV=FALSE
LOCAL=FALSE
WP_DEBUG=FALSE

# APIs de IA
GROQ_API=
GOOGLE_GEMINI_API=

# Stripe (pagos)
GLORY_STRIPE_SECRET_KEY=
GLORY_STRIPE_PUBLISHABLE_KEY=
GLORY_STRIPE_WEBHOOK_SECRET=

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL (Kamples)
KAMPLES_PG_HOST=postgres
KAMPLES_PG_PORT=5432
KAMPLES_PG_DBNAME=kamples
KAMPLES_PG_USER=kamples_app
KAMPLES_PG_PASSWORD=

# FFmpeg (procesamiento de audio)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
